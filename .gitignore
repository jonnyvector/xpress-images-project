# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment variables
.env
.env.*
!.env.example
node_modules/
frontend/node_modules/

# Generated output
output/

# macOS
.DS_Store

# Claude IDE files — local session state stays out, shared guards ship.
# Ignore the contents rather than the directory itself: git cannot re-include
# anything whose parent directory is excluded.
.claude/*
!.claude/settings.json
!.claude/hooks/

# Shopify store export — a regenerable snapshot, not a decision record, and it
# can carry pricing/SKU/inventory data that does not belong in repo history.
# The sign-offs it produces are kept in coverage_signoff.json, which IS tracked.
docs/sales/data/shopify_products.csv

# CodeGraph local index
.codegraph/

# planner state databases (living, per-machine)
.plans/**/plan.db

# geometry regression fixtures (regenerable working copies of output data; tests skip if absent)
tests/qa/fixtures/geometry/*/
