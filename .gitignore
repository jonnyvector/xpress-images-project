# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment variables
.env
.env.*
!.env.example
node_modules/
frontend/node_modules/

# Generated output
output/

# macOS
.DS_Store

# Claude IDE files — local session state stays out, shared guards ship.
# Ignore the contents rather than the directory itself: git cannot re-include
# anything whose parent directory is excluded.
.claude/*
!.claude/settings.json
!.claude/hooks/

# CodeGraph local index
.codegraph/

# planner state databases (living, per-machine)
.plans/**/plan.db

# geometry regression fixtures (regenerable working copies of output data; tests skip if absent)
tests/qa/fixtures/geometry/*/
